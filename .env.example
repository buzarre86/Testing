# Salin fail ini ke .env dan isi nilai sebenar. JANGAN commit fail .env.

# Wajib: kunci API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- Saluran notifikasi bos (isi sekurang-kurangnya satu) ---

# Telegram: cipta bot melalui @BotFather, dapatkan chat ID bos melalui @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (contoh Gmail: guna "App Password", bukan kata laluan biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_BOS=
