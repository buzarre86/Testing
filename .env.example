# Salin fail ini ke .env dan isi nilai sebenar. JANGAN commit fail .env.

# Wajib: kunci API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Sheets (sumber stok) ---
# ID ialah bahagian antara /d/ dan /edit dalam pautan sheet:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
# Nama tab (kosongkan untuk guna tab pertama)
GOOGLE_SHEET_TAB=
# Fail kunci service account (lihat README)
GOOGLE_CREDENTIALS=service_account.json

# --- Telegram (notifikasi bos) ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID bos: jalankan `python cari_chat_id.py` selepas bos tekan Start pada bot
TELEGRAM_CHAT_ID=
